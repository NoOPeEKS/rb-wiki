<div data-controller="chat">
  <!-- Main content - Scrollable, with padding bottom to account for footer -->
  <main class="flex-1 overflow-y-auto pb-[76px]"> <!-- 76px matches footer height -->
    <div class="p-6">
      <div class="max-w-3xl mx-auto space-y-4" data-chat-target="messages">
        <!-- Initial welcome message -->
        <div class="flex justify-start">
          <div class="max-w-sm p-4 rounded-lg bg-muted">
            Welcome! How can I help you today?
          </div>
        </div>
      </div>
      <div data-chat-target="messagesEnd"></div>
    </div>
  </main>

  <!-- Footer - Fixed at bottom of viewport -->
  <footer class="fixed bottom-0 left-0 right-0 border-t p-4 bg-background">
    <form data-action="submit->chat#sendMessage" class="flex items-center space-x-2 max-w-3xl mx-auto">
      <input
        type="text"
        placeholder="Type your message..."
        data-chat-target="input"
        class="flex-1 w-full rounded-md border border-input bg-transparent px-3 py-2 text-sm ring-offset-background placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"
      >
      <button type="submit" class="inline-flex items-center justify-center rounded-md text-sm font-medium ring-offset-background transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring disabled:pointer-events-none disabled:opacity-50 bg-primary text-primary-foreground hover:bg-primary/90 h-10 w-10">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4">
          <line x1="22" y1="2" x2="11" y2="13"></line>
          <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
        </svg>
        <span class="sr-only">Send</span>
      </button>
    </form>
  </footer>
</div>
