<div id="<%= dom_id tool %>">
  <p class="my-5">
    <strong class="block font-medium mb-1">Title:</strong>
    <%= tool.title %>
  </p>

  <p class="my-5">
    <strong class="block font-medium mb-1">Type:</strong>
    <%= tool.type %>
  </p>

  <p class="my-5">
    <strong class="block font-medium mb-1">Date:</strong>
    <%= tool.date %>
  </p>

  <p class="my-5">
    <strong class="block font-medium mb-1">Code repo link:</strong>
    <%= tool.code_repo_link %>
  </p>

  <p class="my-5">
    <strong class="block font-medium mb-1">Document link:</strong>
    <%= tool.document_link %>
  </p>

  <p class="my-5">
    <strong class="block font-medium mb-1">Units:</strong>
    <%= tool.units %>
  </p>

  <p class="my-5">
    <strong class="block font-medium mb-1">Keywords:</strong>
    <%= tool.keywords %>
  </p>

  <p class="my-5">
    <strong class="block font-medium mb-1">Usage:</strong>
    <%= tool.usage %>
  </p>

  <p class="my-5">
    <strong class="block font-medium mb-1">Technology:</strong>
    <%= tool.technology %>
  </p>

</div>
