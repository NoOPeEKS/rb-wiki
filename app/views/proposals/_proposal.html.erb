<div id="<%= dom_id proposal %>">
  <p class="my-5">
    <strong class="block font-medium mb-1">Title:</strong>
    <%= proposal.title %>
  </p>

  <p class="my-5">
    <strong class="block font-medium mb-1">Type:</strong>
    <%= proposal.tipus %>
  </p>

  <p class="my-5">
    <strong class="block font-medium mb-1">Call:</strong>
    <%= proposal.call %>
  </p>

  <p class="my-5">
    <strong class="block font-medium mb-1">Description:</strong>
    <%= proposal.description %>
  </p>

  <p class="my-5">
    <strong class="block font-medium mb-1">App domain:</strong>
    <%= proposal.app_domain %>
  </p>

  <p class="my-5">
    <strong class="block font-medium mb-1">Deadline:</strong>
    <%= proposal.deadline %>
  </p>

  <p class="my-5">
    <strong class="block font-medium mb-1">Duration:</strong>
    <%= proposal.duration %>
  </p>

  <p class="my-5">
    <strong class="block font-medium mb-1">Status:</strong>
    <%= proposal.status %>
  </p>

  <p class="my-5">
    <strong class="block font-medium mb-1">Client:</strong>
    <%= proposal.client %>
  </p>

  <p class="my-5">
    <strong class="block font-medium mb-1">Units involved:</strong>
    <%= proposal.units_involved %>
  </p>

  <p class="my-5">
    <strong class="block font-medium mb-1">People involved:</strong>
    <%= proposal.people_involved %>
  </p>

  <p class="my-5">
    <strong class="block font-medium mb-1">Total budget:</strong>
    <%= proposal.total_budget %>
  </p>

  <p class="my-5">
    <strong class="block font-medium mb-1">Eurecat budget:</strong>
    <%= proposal.eurecat_budget %>
  </p>

  <p class="my-5">
    <strong class="block font-medium mb-1">Eurecat budget excel:</strong>
    <%= proposal.eurecat_budget_excel %>
  </p>

  <p class="my-5">
    <strong class="block font-medium mb-1">Document link:</strong>
    <%= proposal.document_link %>
  </p>

  <p class="my-5">
    <strong class="block font-medium mb-1">Keywords:</strong>
    <%= proposal.keywords %>
  </p>

</div>
