<div class="w-full">
  <% if notice.present? %>
    <p class="py-2 px-3 bg-green-50 mb-5 text-green-500 font-medium rounded-lg inline-block" id="notice"><%= notice %></p>
  <% end %>

  <% content_for :title, "Proposals" %>

  <div class="flex justify-between items-center">
    <h1 class="font-bold text-4xl">Proposals</h1>
    <%= link_to "New proposal", new_proposal_path, class: "rounded-lg py-3 px-5 bg-blue-600 text-white block font-medium" %>
  </div>

  <div id="proposals" class="min-w-full mt-4">
    <ul class="space-y-4">
      <% @proposals.each do |proposal| %>
        <li class="border-b pb-4">
          <h2 class="text-xl font-semibold"><%= link_to proposal.title, proposal_path(proposal), class: "text-purple-600 hover:underline" %></h2>
          <p><%= proposal.keywords %></p>
        </li>
      <% end %>
    </ul>
  </div>
</div>
