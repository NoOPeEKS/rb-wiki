<div id="<%= dom_id project %>">
  <p class="my-5">
    <strong class="block font-medium mb-1">Title:</strong>
    <%= project.title %>
  </p>

  <p class="my-5">
    <strong class="block font-medium mb-1">Type:</strong>
    <%= project.type %>
  </p>

  <p class="my-5">
    <strong class="block font-medium mb-1">Call:</strong>
    <%= project.call %>
  </p>

  <p class="my-5">
    <strong class="block font-medium mb-1">Description:</strong>
    <%= project.description %>
  </p>

  <p class="my-5">
    <strong class="block font-medium mb-1">App domain:</strong>
    <%= project.app_domain %>
  </p>

  <p class="my-5">
    <strong class="block font-medium mb-1">Start date:</strong>
    <%= project.start_date %>
  </p>

  <p class="my-5">
    <strong class="block font-medium mb-1">End date:</strong>
    <%= project.end_date %>
  </p>

  <p class="my-5">
    <strong class="block font-medium mb-1">Duration:</strong>
    <%= project.duration %>
  </p>

  <p class="my-5">
    <strong class="block font-medium mb-1">Client:</strong>
    <%= project.client %>
  </p>

  <p class="my-5">
    <strong class="block font-medium mb-1">Units involved:</strong>
    <%= project.units_involved %>
  </p>

  <p class="my-5">
    <strong class="block font-medium mb-1">People involved:</strong>
    <%= project.people_involved %>
  </p>

  <p class="my-5">
    <strong class="block font-medium mb-1">Total budget:</strong>
    <%= project.total_budget %>
  </p>

  <p class="my-5">
    <strong class="block font-medium mb-1">Eurecat budget:</strong>
    <%= project.eurecat_budget %>
  </p>

  <p class="my-5">
    <strong class="block font-medium mb-1">Eurecat budget excel:</strong>
    <%= project.eurecat_budget_excel %>
  </p>

  <p class="my-5">
    <strong class="block font-medium mb-1">Code repos:</strong>
    <%= project.code_repos %>
  </p>

  <p class="my-5">
    <strong class="block font-medium mb-1">Deliverables:</strong>
    <%= project.deliverables %>
  </p>

  <p class="my-5">
    <strong class="block font-medium mb-1">Presentation:</strong>
    <%= project.presentation %>
  </p>

  <p class="my-5">
    <strong class="block font-medium mb-1">Data sources:</strong>
    <%= project.data_sources %>
  </p>

  <p class="my-5">
    <strong class="block font-medium mb-1">Keywords:</strong>
    <%= project.keywords %>
  </p>

  <p class="my-5">
    <strong class="block font-medium mb-1">Result summary:</strong>
    <%= project.result_summary %>
  </p>

</div>
