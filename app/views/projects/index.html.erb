<div class="w-full">
  <% if notice.present? %>
    <p class="py-2 px-3 bg-green-50 mb-5 text-green-500 font-medium rounded-lg inline-block" id="notice"><%= notice %></p>
  <% end %>

  <% content_for :title, "Projects" %>

  <div class="flex justify-between items-center">
    <h1 class="font-bold text-4xl">Projects</h1>
    <%= link_to "New project", new_project_path, class: "rounded-lg py-3 px-5 bg-blue-600 text-white block font-medium" %>
  </div>

  <div id="projects" class="min-w-full mt-4">
    <ul class="space-y-4">
      <% @projects.each do |project| %>
        <li class="border-b pb-4">
          <h2 class="text-xl font-semibold"><%= link_to project.title, project_path(project), class: "text-purple-600 hover:underline" %></h2>
          <p><%= project.keywords %></p>
        </li>
      <% end %>
    </ul>
  </div>
</div>
