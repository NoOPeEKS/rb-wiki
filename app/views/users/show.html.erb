<div class="min-h-screen bg-gray-50 text-black">
  <header class="bg-white border-b border-gray-200 py-6 sticky top-0 z-10 shadow-sm">
    <div class="container mx-auto px-4">
      <h1 class="text-3xl font-bold">User Profile</h1>
    </div>
  </header>
  <main class="container mx-auto px-4 py-8">
    <div class="bg-white border border-gray-200 rounded-lg shadow-sm">
      <div class="p-6">
        <div class="flex flex-row items-center gap-4">
          <div class="h-20 w-20 rounded-full bg-gray-200 flex items-center justify-center text-xl font-semibold">
            <%= @user.name.split(' ').map { |n| n[0] }.join('') %>
          </div>
          <div>
            <h2 class="text-2xl font-semibold"><%= @user.name %></h2>
            <div class="flex items-center mt-2 text-gray-600">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
              <%= @user.email %>
            </div>
          </div>
        </div>
      </div>
      <div class="px-6 pb-6">
        <div class="flex items-center justify-between">
          <span class="text-gray-600">
            <%= @user.admin? ? "Admin User" : "Regular User" %>
          </span>
        </div>
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mt-8">
      <!-- Articles Section -->
      <div class="bg-white border border-gray-200 rounded-lg shadow-sm hover:shadow-md transition-shadow">
        <div class="p-6 border-b border-gray-100">
          <div class="flex items-center justify-between">
            <h2 class="text-xl font-semibold">Articles</h2>
            <span class="bg-blue-100 text-blue-800 text-xs font-medium px-2.5 py-0.5 rounded-full">
              <%= @user.articles.length %>
            </span>
          </div>
        </div>
        <div class="px-6 py-4">
          <% if @user.articles.length == 0 %>
            <p class="text-sm text-gray-600">The user hasn't yet posted any article</p>
          <% else %>
            <ul class="space-y-4">
              <% @user.articles.each do |article| %>
                <%= link_to article_path(article) do %>
                  <li class="p-4 border border-gray-100 rounded-lg hover:bg-gray-50 transition-colors cursor-pointer">
                    <h3 class="font-semibold text-blue-600 hover:text-blue-800"><%= article.title %></h3>
                    <p class="text-sm text-gray-600 mt-1"><%= article.created_at.strftime("%B %d, %Y") %></p>
                  </li>
                <% end %>
              <% end %>
            </ul>
          <% end %>
        </div>
      </div>

      <!-- Projects Section -->
      <div class="bg-white border border-gray-200 rounded-lg shadow-sm hover:shadow-md transition-shadow">
        <div class="p-6 border-b border-gray-100">
          <div class="flex items-center justify-between">
            <h2 class="text-xl font-semibold">Projects</h2>
            <span class="bg-green-100 text-green-800 text-xs font-medium px-2.5 py-0.5 rounded-full">
              <%= @user.projects.length %>
            </span>
          </div>
        </div>
        <div class="px-6 py-4">
          <% if @user.projects.length == 0 %>
            <p class="text-sm text-gray-600">The user hasn't yet posted any project</p>
          <% else %>
            <ul class="space-y-4">
              <% @user.projects.each do |project| %>
                <%= link_to project_path(project) do %>
                  <li class="p-4 border border-gray-100 rounded-lg hover:bg-gray-50 transition-colors cursor-pointer">
                    <h3 class="font-semibold text-green-600 hover:text-green-800"><%= project.title %></h3>
                    <p class="text-sm text-gray-600 mt-1"><%= project.created_at.strftime("%B %d, %Y") %></p>
                  </li>
                <% end %>
              <% end %>
            </ul>
          <% end %>
        </div>
      </div>

      <!-- Proposals Section -->
      <div class="bg-white border border-gray-200 rounded-lg shadow-sm hover:shadow-md transition-shadow">
        <div class="p-6 border-b border-gray-100">
          <div class="flex items-center justify-between">
            <h2 class="text-xl font-semibold">Proposals</h2>
            <span class="bg-purple-100 text-purple-800 text-xs font-medium px-2.5 py-0.5 rounded-full">
              <%= @user.proposals.length %>
            </span>
          </div>
        </div>
        <div class="px-6 py-4">
          <% if @user.proposals.length == 0 %>
            <p class="text-sm text-gray-600">The user hasn't yet posted any proposal</p>
          <% else %>
            <ul class="space-y-4">
              <% @user.proposals.each do |proposal| %>
                <%= link_to proposal_path(proposal) do %>
                  <li class="p-4 border border-gray-100 rounded-lg hover:bg-gray-50 transition-colors cursor-pointer">
                    <h3 class="font-semibold text-purple-600 hover:text-purple-800"><%= proposal.title %></h3>
                    <p class="text-sm text-gray-600 mt-1"><%= proposal.created_at.strftime("%B %d, %Y") %></p>
                  </li>
                <% end %>
              <% end %>
            </ul>
          <% end %>
        </div>
      </div>

      <!-- Tools Section -->
      <div class="bg-white border border-gray-200 rounded-lg shadow-sm hover:shadow-md transition-shadow">
        <div class="p-6 border-b border-gray-100">
          <div class="flex items-center justify-between">
            <h2 class="text-xl font-semibold">Tools</h2>
            <span class="bg-orange-100 text-orange-800 text-xs font-medium px-2.5 py-0.5 rounded-full">
              <%= @user.tools.length %>
            </span>
          </div>
        </div>
        <div class="px-6 py-4">
          <% if @user.tools.length == 0 %>
            <p class="text-sm text-gray-600">The user hasn't yet posted any tool</p>
          <% else %>
            <ul class="space-y-4">
              <% @user.tools.each do |tool| %>
                <%= link_to tool_path(tool) do %>
                  <li class="p-4 border border-gray-100 rounded-lg hover:bg-gray-50 transition-colors cursor-pointer">
                    <h3 class="font-semibold text-orange-600 hover:text-orange-800"><%= tool.title %></h3>
                    <p class="text-sm text-gray-600 mt-1"><%= tool.created_at.strftime("%B %d, %Y") %></p>
                  </li>
                <% end %>
              <% end %>
            </ul>
          <% end %>
        </div>
      </div>
    </div>
  </main>
</div>
